{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "check-format": "prettier --check .",
    "check-lint": "eslint . --ext ts --ext tsx --ext js",
    "check-types": "tsc --pretty --noEmit",
    "lint:js": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:styles": "stylelint src/**/*.css --fix",
    "check-styles": "stylelint src/**/*.css",
    "lint:prettier": "prettier --check \"**/*.md\" --ignore-path .gitignore",
    "lint": "npm run lint:js && npm run lint:styles && npm run lint:prettier",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bem-react/classname": "1.8.0",
    "@gravity-ui/icons": "2.18.0",
    "@gravity-ui/navigation": "4.0.15",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/client-runtime-utils": "7.8.0",
    "@prisma/extension-accelerate": "3.0.1",
    "axios": "1.16.0",
    "bem-cn-lite": "4.1.0",
    "i18next": "26.1.0",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.0",
    "next": "16.2.6",
    "nodemailer": "8.0.7",
    "pg": "^8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.75.0",
    "react-i18next": "17.0.7",
    "react-toastify": "11.1.0",
    "server-only": "0.0.1",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.4",
    "@gravity-ui/browserslist-config": "4.4.0",
    "@gravity-ui/components": "4.19.0",
    "@gravity-ui/uikit": "7.38.0",
    "@playwright/test": "1.62.1",
    "@svgr/webpack": "8.1.0",
    "@types/node": "25.7.0",
    "@types/nodemailer": "8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "jsdom": "30.0.1",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "stylelint": "17.11.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": "24"
  },
  "browserslist": [
    "extends @gravity-ui/browserslist-config"
  ],
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
