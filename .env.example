# PostgreSQL connection string
# For Neon: postgresql://user:password@host/dbname?sslmode=require
# For Prisma Accelerate: prisma://accelerate.prisma-data.net/?api_key=...
DATABASE_URL=postgresql://user:password@host:5432/portfolio

# Public base URL of the deployed app (used for internal API calls)
NEXT_PUBLIC_LOCALHOST_API=https://your-domain.vercel.app

# Gmail SMTP credentials for the contact form
# Use a Gmail App Password (not your account password):
# https://myaccount.google.com/apppasswords
SMTP_SERVER_HOST=smtp.gmail.com
SMTP_SERVER_USERNAME=your-email@gmail.com
SMTP_SERVER_PASSWORD=your-app-password

# Email address that receives contact form submissions
SITE_MAIL_RECIEVER=your-email@gmail.com
