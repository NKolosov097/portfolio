# PostgreSQL connection string for Drizzle/node-postgres (use the provider's pooled URL).
DATABASE_URL=postgresql://user:password@host:5432/portfolio
# Optional direct connection for migrations. Falls back to DATABASE_URL.
DIRECT_DATABASE_URL=
# Name supplied automatically by the Neon Vercel integration; also accepted for migrations.
DATABASE_URL_UNPOOLED=
# Safe-prefix names used by the connected Neon Vercel Marketplace resource.
CONTACT_DB_DATABASE_URL=
CONTACT_DB_DATABASE_URL_UNPOOLED=

# Public base URL of the deployed app (used for internal API calls)
NEXT_PUBLIC_LOCALHOST_API=https://nkolosov.com

# SMTP owner notifications. Gmail requires an App Password, not an account password.
SMTP_SERVER_HOST=smtp.gmail.com
SMTP_SERVER_PORT=465
SMTP_SERVER_SECURE=true
SMTP_SERVER_USERNAME=n.kolosov097@gmail.com
SMTP_SERVER_PASSWORD=your-app-password
SMTP_FROM=n.kolosov097@gmail.com

# Email address that receives contact form submissions
SITE_MAIL_RECIEVER=n.kolosov097@gmail.com

# Generate a long random secret. Used to hash temporary rate-limit identities.
CONTACT_RATE_LIMIT_SECRET=
# Optional temporary email bucket, 6..1000 submissions per 10 minutes (default 20).
CONTACT_EMAIL_RATE_LIMIT=20
# Production: a single-IP header overwritten by YOUR trusted reverse proxy.
# The proxy must remove the visitor's supplied value. Do not blindly trust forwarded headers.
# Leave unset until deployment is configured; production submissions then fail closed.
CONTACT_TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Vercel sends CRON_SECRET as Authorization: Bearer <secret> to cron routes.
CRON_SECRET=
# Separate bearer secret for the aggregate-only operational status route.
OPERATIONS_SECRET=
# Maximum messages claimed by one retry run (1..100, default 25).
CONTACT_RETRY_LIMIT=25
